generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id       String @id @default(uuid())
  username String @unique
  password String // Bcrypt hashed
  role     String @default("ADMIN")
}

model Employee {
  id             String              @id @default(uuid())
  firstName      String
  lastName       String
  position       String
  hourlyRate     Float               @default(0)
  baseCommission Float               @default(0)
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  transactions   Transaction[]
  payrolls       Payroll[]
  deductions     EmployeeDeduction[]
}

model Service {
  id             String        @id @default(uuid())
  name           String        @unique
  price          Float
  commissionRate Float         @default(0)  // Amount: % of price OR fixed peso amount
  commissionType String        @default("PERCENTAGE") // "PERCENTAGE" or "FIXED"
  isActive       Boolean       @default(true)
  transactions   Transaction[]
}

model Transaction {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  
  // Relations
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id])

  // Snapshots (storing price at time of sale in case service price changes later)
  soldPrice        Float
  commissionAmount Float
}

model Expense {
  id          String   @id @default(uuid())
  description String
  amount      Float
  category    String   // "FIXED" or "VARIABLE"
  date        DateTime @default(now())
  isRecurring Boolean  @default(false)
}

model EmployeeDeduction {
  id          String   @id @default(uuid())
  description String
  amount      Float
  type        String   // "CASH_ADVANCE" | "EQUIPMENT" | "PENALTY" | "OTHER"
  date        DateTime @default(now())
  isDeducted  Boolean  @default(false) // true once applied in a payroll

  // Relations
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])

  // Filled when deducted via payroll
  payrollId   String?
  payroll     Payroll? @relation(fields: [payrollId], references: [id])
}

model Payroll {
  id                String              @id @default(uuid())
  payrollDate       DateTime            @default(now())
  startDate         DateTime
  endDate           DateTime
  totalHoursWorked  Float               @default(0)
  commissionsEarned Float               @default(0)
  grossSalary       Float
  taxDeductions     Float
  netSalary         Float
  employeeId        String
  employee          Employee            @relation(fields: [employeeId], references: [id])
  deductions        EmployeeDeduction[]
}
